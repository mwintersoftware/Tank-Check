# Server-seitig (Hosting-Env / lokal in web/.env)
TANKERKOENIG_API_KEY=

# Optional: Orts-Slug für Zwischenlösung ohne Key (Default: oberasbach)
# DE_PRICE_CITY=oberasbach

# Postgres-Verbindungs-URL für Preishistorie / Ausflugstag-Vorschläge
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Geheimnis für /api/cron/snapshot (Authorization: Bearer …)
# CRON_SECRET=
